# Gmail SMTP settings for Keycloak and Spring services.
# Use a Google App Password, not the normal Gmail account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=replace-with-a-google-app-password
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_FROM=your-account@gmail.com

# Local infrastructure credentials. Generate unique values per environment.
DB_USERNAME=workora
DB_PASSWORD=replace-with-a-database-password
RABBITMQ_USERNAME=workora
RABBITMQ_PASSWORD=replace-with-a-rabbitmq-password
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-minio-password
# URL browsers use for presigned uploads. Use the public MinIO URL in deployed environments.
STORAGE_MINIO_PRESIGN_ENDPOINT=http://localhost:9000
STORAGE_MINIO_REGION=us-east-1
KEYCLOAK_ADMIN_USERNAME=replace-with-a-keycloak-admin-user
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/workora
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/workora/protocol/openid-connect/certs
KEYCLOAK_REALM=workora
KEYCLOAK_CLIENT_ID=workora-api
KEYCLOAK_FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-jwt-secret
NOTIFICATION_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Gateway and service addresses.
GATEWAY_PORT=8080
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
IDENTITY_SERVICE_PORT=8101
IDENTITY_SERVICE_URL=http://identity-service:8101
ORGANIZATION_SERVICE_URL=http://organization-service:8102
PROJECT_SERVICE_URL=http://project-service:8103
WORK_SERVICE_URL=http://work-service:8104
BUG_SERVICE_URL=http://bug-service:8105
RECRUITMENT_SERVICE_URL=http://recruitment-service:8106
NOTIFICATION_SERVICE_URL=http://notification-service:8107
PAYMENT_SERVICE_URL=http://payment-service:8108

# Optional Spring runtime settings.
JPA_DDL_AUTO=update
JPA_FORMAT_SQL=true
JPA_OPEN_IN_VIEW=false
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
