# Copy these entries into the ignored .env file and set a different random
# password for every service. DB_USERNAME/DB_PASSWORD remain the PostgreSQL
# administrator credentials and are not used by application containers.
DB_IDENTITY_USERNAME=identity_app
DB_IDENTITY_PASSWORD=
DB_ORGANIZATION_USERNAME=organization_app
DB_ORGANIZATION_PASSWORD=
DB_PROJECT_USERNAME=project_app
DB_PROJECT_PASSWORD=
DB_WORK_USERNAME=work_app
DB_WORK_PASSWORD=
DB_BUG_USERNAME=bug_app
DB_BUG_PASSWORD=
DB_RECRUITMENT_USERNAME=recruitment_app
DB_RECRUITMENT_PASSWORD=
DB_NOTIFICATION_USERNAME=notification_app
DB_NOTIFICATION_PASSWORD=
DB_PAYMENT_USERNAME=payment_app
DB_PAYMENT_PASSWORD=
